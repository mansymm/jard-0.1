{
  "name": "factory-inventory-app",
  "version": "2.1.0",
  "description": "تطبيق جرد المخزون الاحترافي للموبايل",
  "scripts": {
    "prepare-web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});['index.html','style.css','app.js','manifest.json','sw.js','icon-192.png','icon-512.png'].forEach(f=>fs.copyFileSync(f,'www/'+f));\""
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  }
}
